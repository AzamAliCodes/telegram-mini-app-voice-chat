# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username   # without @ prefix
MINIAPP_URL=https://your-domain.com
OWNER_IDS=123456789,987654321           # Comma-separated Developer IDs


# MongoDB
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/vcbot

# Redis
REDIS_URL=redis://redis:6379


# LiveKit SFU (Replacing TURN/Signaling)
# Get these from https://cloud.livekit.io (Free) or self-host
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret


# App & Deployment
BACKEND_URL=https://your-space.hf.space
MINIAPP_URL=https://your-app.netlify.app
ENVIRONMENT=production
TELEGRAM_API_PROXY= # OPTIONAL: Cloudflare worker URL (e.g., https://tg-proxy.workers.dev)

# Support
SUPPORT_CHANNEL=your_support_channel # without @ prefix
